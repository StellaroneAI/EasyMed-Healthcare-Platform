# Generate ADMIN_PASSWORD_HASH locally with:
# node -e "const crypto=require('crypto');const p=process.argv[1],s=crypto.randomBytes(16).toString('hex');const h=crypto.scryptSync(p,s,32).toString('base64url');console.log(s+'$'+h)" "replace-with-a-strong-password"

